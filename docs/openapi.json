{
  "paths": {
    "/openapi/growth-decision/products": {
      "post": {
        "operationId": "createProduct",
        "summary": "创建需要监控的广告产品",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "targetMetric", "channel"],
                "properties": {
                  "name": { "type": "string", "description": "产品名称", "example": "Product A" },
                  "targetMetric": { "type": "string", "description": "主要优化指标", "example": "cpa" },
                  "channel": { "type": "string", "description": "广告渠道", "example": "facebook" },
                  "accountId": { "type": "string", "description": "渠道账户 ID", "example": "act_123456" },
                  "dorisSource": { "type": "string", "description": "Doris 数据集标识", "example": "growth.product_a_hourly" },
                  "dataDelayMinutes": { "type": "integer", "description": "数据预计延迟分钟数", "example": 60 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建后的产品配置",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "id": "2e37d29d-2ec7-4c55-a764-129f5ccbb435",
                    "name": "Product A",
                    "status": "active",
                    "targetMetric": "cpa",
                    "channel": "facebook",
                    "dataDelayMinutes": 60,
                    "skillVersion": "product-standard-pending",
                    "metrics": [
                      { "key": "cpi", "label": "CPI", "availability": "direct", "standardValue": 1.5, "anomalyThreshold": 1.8 },
                      { "key": "d0_roas", "label": "D0 ROAS", "availability": "direct", "standardValue": 0.3, "anomalyThreshold": 0.24 }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi/growth-decision/cases": {
      "post": {
        "operationId": "ingestCase",
        "summary": "写入异常、原因分析和行动建议",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "productId", "anomalyType", "severity", "channel",
                  "targetMetric", "evidence", "rootCause", "confidence",
                  "recommendation", "recommendedAction", "expectedImpact"
                ],
                "properties": {
                  "productId": { "type": "string", "description": "产品配置 ID", "example": "2e37d29d-2ec7-4c55-a764-129f5ccbb435" },
                  "anomalyType": { "type": "string", "description": "异常类型", "example": "CPA 突然上升" },
                  "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"], "description": "异常严重度", "example": "high" },
                  "channel": { "type": "string", "description": "广告渠道", "example": "facebook" },
                  "campaignId": { "type": "string", "description": "Campaign ID", "example": "238512345678" },
                  "campaignName": { "type": "string", "description": "Campaign 名称", "example": "US_iOS_Prospecting" },
                  "adsetId": { "type": "string", "description": "Ad Set ID", "example": "238512345679" },
                  "adsetName": { "type": "string", "description": "Ad Set 名称", "example": "US_Broad_25-44" },
                  "audienceId": { "type": "string", "description": "人群 ID", "example": "aud_us_broad" },
                  "audienceName": { "type": "string", "description": "人群名称", "example": "US Broad 25-44" },
                  "adId": { "type": "string", "description": "广告 ID", "example": "238512345680" },
                  "adName": { "type": "string", "description": "广告名称", "example": "Video_UGC_07" },
                  "creativeId": { "type": "string", "description": "素材 ID", "example": "creative_07" },
                  "creativeName": { "type": "string", "description": "素材名称", "example": "UGC Hook 07" },
                  "targetMetric": { "type": "string", "description": "发生异常的核心指标", "example": "cpa" },
                  "currentValue": { "type": "number", "description": "指标当前值", "example": 42.8 },
                  "baselineValue": { "type": "number", "description": "对照基线值", "example": 31.2 },
                  "deviationPct": { "type": "number", "description": "相对基线变化百分比", "example": 37.2 },
                  "metricValues": { "type": "object", "description": "产品默认指标快照", "example": { "cpi": 1.42, "cpa": 8.6, "d0_roas": 0.21, "ecpm": 4.8, "retention_d1": 0.31, "ipu": 0.08, "arpu": 0.36 } },
                  "evidence": { "type": "string", "description": "异常检测证据", "example": "过去 3 小时消耗 560 美元，转化 14 个，CPA 较七日同时段上升 37.2%。" },
                  "rootCause": { "type": "string", "description": "原因分析结论", "example": "CTR 连续三天下降且 Frequency 升至 4.9，素材疲劳概率较高。" },
                  "confidence": { "type": "number", "description": "原因判断置信度百分比", "example": 78 },
                  "recommendation": { "type": "string", "description": "可执行行动建议", "example": "暂停疲劳素材并启用两条新 UGC 素材，预算暂不调整。" },
                  "recommendedAction": { "type": "object", "description": "结构化执行参数", "example": { "actionType": "rotate_creative", "targetLevel": "ad", "targetId": "238512345680" } },
                  "expectedImpact": { "type": "string", "description": "预期业务改善", "example": "72 小时内 CPA 下降至少 10%，转化量下降不超过 15%。" },
                  "riskNote": { "type": "string", "description": "风险和回滚条件", "example": "若 24 小时内转化量下降超过 15%，恢复原素材。" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "进入待决策队列的案例",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "id": "8dd23410-61df-44df-9d3c-164933134da5",
                    "productId": "2e37d29d-2ec7-4c55-a764-129f5ccbb435",
                    "productName": "Product A",
                    "status": "pending",
                    "anomalyType": "CPA 突然上升",
                    "confidence": 78,
                    "metricValues": { "cpi": 1.42, "cpa": 8.6, "d0_roas": 0.21 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi/growth-decision/judgments": {
      "post": {
        "operationId": "ingestJudgment",
        "summary": "写入异常、第一波分析和初步判断",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "productId", "anomalyType", "severity", "channel",
                  "targetMetric", "evidence", "rootCause", "confidence",
                  "preliminaryJudgment"
                ],
                "properties": {
                  "productId": { "type": "string", "description": "产品配置 ID", "example": "579150cc-4ebe-4f27-891d-2dbc375d7889" },
                  "anomalyType": { "type": "string", "description": "异常类型", "example": "D0 ROAS 明显下降" },
                  "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"], "description": "异常严重度", "example": "high" },
                  "channel": { "type": "string", "description": "广告渠道", "example": "facebook" },
                  "campaignId": { "type": "string", "description": "Campaign ID", "example": "238512345678" },
                  "campaignName": { "type": "string", "description": "Campaign 名称", "example": "IN_Android_Broad" },
                  "adsetId": { "type": "string", "description": "Ad Set ID", "example": "238512345679" },
                  "adsetName": { "type": "string", "description": "Ad Set 名称", "example": "IN_Broad" },
                  "audienceId": { "type": "string", "description": "人群 ID", "example": "aud_in_broad" },
                  "audienceName": { "type": "string", "description": "人群名称", "example": "IN Broad" },
                  "adId": { "type": "string", "description": "广告 ID", "example": "238512345680" },
                  "adName": { "type": "string", "description": "广告名称", "example": "WL_Video_07" },
                  "creativeId": { "type": "string", "description": "素材 ID", "example": "creative_07" },
                  "creativeName": { "type": "string", "description": "素材名称", "example": "WL Hook 07" },
                  "targetMetric": { "type": "string", "description": "发生异常的核心指标", "example": "d0_roas" },
                  "currentValue": { "type": "number", "description": "指标当前值", "example": 0.18 },
                  "baselineValue": { "type": "number", "description": "对照基线值", "example": 0.24 },
                  "deviationPct": { "type": "number", "description": "相对基线变化百分比", "example": -25 },
                  "metricValues": { "type": "object", "description": "产品默认指标快照", "example": { "cpi": 1.42, "d0_roas": 0.18, "ecpm": 4.8, "arpu": 0.31 } },
                  "evidence": { "type": "string", "description": "异常检测证据", "example": "成熟 cohort 的 D0 ROAS 较七日同小时基线下降 25%。" },
                  "rootCause": { "type": "string", "description": "第一波原因分析", "example": "CTR 稳定但安装后收入下降，问题更可能位于产品转化侧。" },
                  "confidence": { "type": "number", "description": "判断置信度百分比", "example": 76 },
                  "preliminaryJudgment": { "type": "string", "description": "等待人工确认的初步判断", "example": "异常真实，暂不归因于素材疲劳。" },
                  "skillRuleCandidate": { "type": "string", "description": "可进入周复盘的 Skill 候选规则", "example": "CTR 稳定而 D0 ROAS 下降时优先检查产品收入链路。" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "进入人工判断队列的异常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "id": "8dd23410-61df-44df-9d3c-164933134da5",
                    "productName": "Wingslite",
                    "status": "judgment_pending",
                    "preliminaryJudgment": "异常真实，暂不归因于素材疲劳。",
                    "metricValues": { "cpi": 1.42, "d0_roas": 0.18, "ecpm": 4.8, "arpu": 0.31 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi/growth-decision/judgments/{id}/recommendations": {
      "post": {
        "operationId": "createRecommendationFromJudgment",
        "summary": "基于已确认判断创建调整建议",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string" },
            "description": "已确认的异常判断 ID",
            "example": "8dd23410-61df-44df-9d3c-164933134da5"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["recommendation", "recommendedAction", "expectedImpact"],
                "properties": {
                  "recommendation": { "type": "string", "description": "可执行调整建议", "example": "保持预算不变，先排查产品收入事件与 cohort 回传。" },
                  "recommendedAction": { "type": "object", "description": "结构化执行参数", "example": { "actionType": "investigate_tracking", "targetLevel": "campaign", "targetId": "238512345678" } },
                  "expectedImpact": { "type": "string", "description": "预期结果与观察窗口", "example": "24 小时内确认收入回传完整性，再决定是否调整预算。" },
                  "riskNote": { "type": "string", "description": "风险与回滚条件", "example": "排查期间不改变预算，避免把数据问题误判为投放问题。" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "进入建议审核队列的调整建议",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "id": "5c29ce5d-3348-4277-8630-3d39e974770c",
                    "status": "pending",
                    "recommendation": "保持预算不变，先排查产品收入事件与 cohort 回传。"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
