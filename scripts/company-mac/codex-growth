#!/bin/zsh
set -euo pipefail

readonly KEYCHAIN_SERVICE="ai-growth-doris-superset-mcp"

if ! command -v security >/dev/null 2>&1; then
  print -u2 "未找到 macOS Keychain 命令。"
  exit 1
fi

if ! command -v codex >/dev/null 2>&1; then
  print -u2 "未找到 Codex CLI。请先安装终端版 Codex。"
  exit 1
fi

token="$(security find-generic-password \
  -a "$USER" \
  -s "$KEYCHAIN_SERVICE" \
  -w 2>/dev/null || true)"

if [[ -z "$token" ]]; then
  print -u2 "钥匙串中没有 Doris/Superset MCP Key。"
  print -u2 "请先运行：zsh scripts/company-mac/setup.sh"
  exit 1
fi

export DORIS_SUPERSET_MCP_TOKEN="$token"
unset token

exec codex "$@"
